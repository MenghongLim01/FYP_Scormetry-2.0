# Copy this to .env on the server:  cp .env.docker.example .env
# Then set APP_KEY (see deploy steps), APP_URL, DB_PASSWORD and your mail settings.

APP_NAME=Scormetry
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://YOUR_DROPLET_IP

APP_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=error

# 'db' is the docker-compose database service name — do not change to 127.0.0.1
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=scormetry
DB_USERNAME=scormetry
DB_PASSWORD=change-me-to-a-strong-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# Email is needed for OTP login + notifications. 'log' writes to storage/logs
# instead of sending. Use real SMTP (Brevo, Mailgun, Gmail, …) in production.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@scormetry.app"
MAIL_FROM_NAME="${APP_NAME}"

# Google OAuth (login + optional Calendar sync). Both redirect URIs must be
# registered under the same OAuth client's Authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://scormetry.app/auth/google/callback
GOOGLE_CALENDAR_REDIRECT_URI=https://scormetry.app/google-calendar/callback
